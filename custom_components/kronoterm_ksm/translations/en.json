{
  "config": {
    "step": {
      "user": {
        "title": "Kronoterm heat pump",
        "description": "Connection to the KSM controller over Modbus (through a Wi-Fi/Ethernet RS485 bridge).",
        "data": {
          "host": "Bridge address (IP or hostname)",
          "port": "Port",
          "protocol": "Protocol",
          "slave_id": "Modbus address of the heat pump"
        },
        "data_description": {
          "host": "For example the Pico W bridge: 192.168.1.50",
          "protocol": "Pico W bridge from this repository = RTU over TCP. Ready-made Modbus TCP gateways = Modbus TCP.",
          "slave_id": "Kronoterm default is 20"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to the bridge or the heat pump does not answer. Check the address, port, protocol and Modbus address.",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This heat pump is already configured"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Kronoterm options",
        "data": {
          "scan_interval": "Polling interval (seconds)",
          "thermal_multiplier": "Thermal energy multiplier"
        },
        "data_description": {
          "thermal_multiplier": "Some controllers count thermal energy in other units. Leave 1 unless thermal / electrical energy differs from the SCOP."
